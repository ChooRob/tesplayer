# Media servers: set Plex, Jellyfin, or both. The login page offers a
# sign-in button for each one configured, and shows an error naming the
# setting if neither is set or one is malformed.
# Plex: PLEX_EMAIL is the one Plex account that may sign in (its Home profiles
# can too). It must be the account that owns your Plex server. The first time it
# signs in, FreeStuffCrazy Player finds your server and saves what it needs to
# reach it in its data folder, so that is all a normal setup requires.
PLEX_EMAIL=you@example.com
# Optional, except with more than one server. PLEX_URL is the address to try
# first. If your account owns MORE THAN ONE Plex server, set it to the address of
# the one you want; otherwise the first server plex.tv lists is used (the log
# says which). It also helps when the server is not found automatically, for
# example behind Docker networking. PLEX_TOKEN is your Plex token, if you would
# rather name it here than have it saved at first sign-in. Setups with a plugin
# that chooses servers still need PLEX_TOKEN.
# PLEX_URL=http://plex.example.com:32400
# PLEX_TOKEN=
# Jellyfin: just the server's address, http(s)://host[:port][/path], with no
# username, password or query string. Anyone with an account on it may sign in.
# JELLYFIN_URL=https://jellyfin.example.com
# JELLYFIN_NAME=Home Jellyfin (optional display name for the server)
ITEM_KEY=
PORT=3000
# Signs session cookies for the Plex-login gate (see config.json for its
# enabled/requireServerAccess/sessionDays settings). Generate your own:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme

# Local development binds only loopback. For remote access use an HTTPS reverse proxy.
HOST=127.0.0.1
NODE_ENV=development
# Production: set NODE_ENV=production and APP_ORIGIN=https://your-app.example.com
# Trust only your reverse proxy's IP/CIDR, never arbitrary forwarded headers.
# TRUST_PROXY=loopback
# DATA_DIR=/app/data
# PLEX_CLIENT_ID=unique-installation-id (otherwise generated and persisted)
# Trusted plugins: a directory of *-plugin.js files and/or comma-separated
# module paths. See README.md and plugins.js. Plugins may read their own env vars.
# FREESTUFFCRAZY_PLUGINS_DIR=/path/to/plugins
# FREESTUFFCRAZY_PLUGIN_MODULES=/path/to/my-plugin.js

# Optional Admin page for plugins: set the SHA-256 digest of a separate
# 64-hex-character token. The admin is the PLEX_EMAIL account's owner profile,
# or an administrator of the JELLYFIN_URL server.
FREESTUFFCRAZY_ADMIN_TOKEN_SHA256=
# Best practice: enable token unlock while setting up passkeys, then switch
# back to passkey-only. Passkey unlock works in either mode.
FREESTUFFCRAZY_ADMIN_ALLOW_TOKEN=false
